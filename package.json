{
  "name": "la-casa-quote-studio",
  "version": "1.0.1",
  "private": true,
  "author": "La Casa Interiors",
  "description": "Private quotation management for La Casa Interiors.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check desktop/main.cjs && node --check app.js && node --check scripts/generate-mac-icon.cjs",
    "make:mac-icon": "node scripts/generate-mac-icon.cjs && sh scripts/make-mac-icon.sh",
    "predist": "node scripts/generate-mac-icon.cjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.lacasa.quotestudio",
    "productName": "La Casa Quote Studio",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "index.html",
      "styles.css",
      "app.js",
      "manifest.json",
      "sw.js",
      "assets/icon.svg",
      "assets/la-casa-logo.png",
      "assets/la-casa.ico"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
